<Window x:Class="PostOffice.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Language="ru-RU"
        Icon="/Assets/Images/icon.png"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Title="О программе"
        KeyDown="AboutWindow_KeyDown">

    <Grid Width="760"
          Height="400">
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Images/bg_about.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Полупрозрачная подложка, чтобы текст читался на фоне картинки -->
        <Border VerticalAlignment="Center"
                Margin="40"
                CornerRadius="8"
                Padding="24">
            <Border.Background>
                <SolidColorBrush Color="Black" Opacity="0.45"/>
            </Border.Background>
            <TextBlock TextAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="Gold">
                Почтовое отделение<LineBreak/>
                Курсовой проект .NET, вариант 1 «Почта»<LineBreak/>
                WPF, ADO.NET, Entity Framework Core<LineBreak/>
                Разработчики: Жариков Ярослав, Сойкин Святослав<LineBreak/>
                Группа: ПВ521<LineBreak/>
                Год: 2026<LineBreak/>
                <LineBreak/>

                <Run FontSize="14" FontWeight="Normal" Foreground="Beige">
                    Иконки: FatCow Web Hosting, лицензия CC BY 3.0
                </Run><LineBreak/>
                <Run FontSize="16" FontWeight="Normal" Foreground="Beige">
                    Нажмите Esc для закрытия
                </Run>
            </TextBlock>
        </Border>
    </Grid>
</Window>
