<Window x:Class="PostOffice.Views.PostmanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource WindowStyle}"
        Language="ru-RU"
        Icon="/Assets/Images/icon.png"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=TbxSurname}"
        Title="Приём почтальона на работу">

    <!-- Привязки пишут прямо в анкету почтальона. Паспорт введён на предыдущем шаге;
         если человек уже есть в базе, его ФИО подставлены и не правятся -->
    <StackPanel Margin="24 18">
        <TextBlock Text="Серия и номер паспорта"
                   Style="{DynamicResource InputPromptStyle}"/>
        <TextBox x:Name="TbxPassport"
                 Text="{Binding Passport, Mode=OneWay}"
                 IsReadOnly="True"
                 Style="{DynamicResource InputBoxStyle}"/>

        <TextBlock Text="Фамилия"
                   Style="{DynamicResource InputPromptStyle}"/>
        <TextBox x:Name="TbxSurname"
                 Text="{Binding Surname, ValidatesOnExceptions=True}"
                 Style="{DynamicResource InputBoxStyle}"/>

        <TextBlock Text="Имя"
                   Style="{DynamicResource InputPromptStyle}"/>
        <TextBox x:Name="TbxName"
                 Text="{Binding Name, ValidatesOnExceptions=True}"
                 Style="{DynamicResource InputBoxStyle}"/>

        <TextBlock Text="Отчество (если отчества нет, оставьте поле пустым)"
                   Style="{DynamicResource InputPromptStyle}"/>
        <TextBox x:Name="TbxPatronymic"
                 Text="{Binding Patronymic, ValidatesOnExceptions=True}"
                 Style="{DynamicResource InputBoxStyle}"/>

        <TextBlock x:Name="TblLogin"
                   Text="Логин для входа в программу"
                   Style="{DynamicResource InputPromptStyle}"/>
        <TextBox x:Name="TbxLogin"
                 Text="{Binding Login, ValidatesOnExceptions=True}"
                 Style="{DynamicResource InputBoxStyle}"/>

        <TextBlock Text="Пароль"
                   Style="{DynamicResource InputPromptStyle}"/>
        <PasswordBox x:Name="PbxPassword"
                     Style="{DynamicResource InputPasswordStyle}"/>

        <!-- участок переходит к новому почтальону от прежнего; в анкету записывается Id участка -->
        <TextBlock Text="Участок, который выделяется почтальону"
                   Style="{DynamicResource InputPromptStyle}"/>
        <ComboBox x:Name="CbxDistrict"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding DistrictId}"
                  Style="{DynamicResource InputListStyle}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="Участок"/>
                        <Run Text="{Binding Number, Mode=OneWay}"/>
                        <Run Text="- сейчас у почтальона"/>
                        <Run Text="{Binding PostmanShortName, Mode=OneWay}"/>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0 16 0 0">
            <Button Content="Принять"
                    Style="{DynamicResource DialogButtonStyle}"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
            <Button Content="Отмена"
                    Style="{DynamicResource DialogButtonStyle}"
                    IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
