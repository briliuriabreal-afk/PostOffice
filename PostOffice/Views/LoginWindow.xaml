<Window x:Class="PostOffice.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource WindowStyle}"
        Language="ru-RU"
        Icon="/Assets/Images/icon.png"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=TbxLogin}"
        Title="Вход в почтовое отделение">

    <StackPanel Margin="24 18">
        <TextBlock Text="Логин"
                   Style="{DynamicResource InputPromptStyle}"/>
        <TextBox x:Name="TbxLogin"
                 Style="{DynamicResource InputBoxStyle}"/>

        <TextBlock Text="Пароль"
                   Style="{DynamicResource InputPromptStyle}"/>
        <PasswordBox x:Name="PbxPassword"
                     Style="{DynamicResource InputPasswordStyle}"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0 16 0 0">
            <Button Content="Войти"
                    Style="{DynamicResource DialogButtonStyle}"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
            <Button Content="Отмена"
                    Style="{DynamicResource DialogButtonStyle}"
                    IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
