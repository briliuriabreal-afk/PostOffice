    <None Remove="Assets\Images\client.png" />
    <None Remove="Assets\Images\subscription.png" />
    <None Remove="Assets\Images\publication.png" />
    <None Remove="Assets\Images\report.png" />
    <None Remove="Assets\Images\summary.png" />
    <None Remove="Assets\Images\help.png" />
    <None Remove="Assets\Images\exit.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\icon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
