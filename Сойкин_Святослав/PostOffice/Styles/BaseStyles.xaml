<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="MenuBaseStyle" TargetType="Menu">
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="ToolBarButtonBaseStyle" TargetType="Button">
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Кнопки окон ввода и панелей команд над таблицами -->
    <Style x:Key="DialogButtonBaseStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="Margin" Value="8 0"/>
        <Setter Property="Padding" Value="12 6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PanelButtonBaseStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonBaseStyle}">
        <Setter Property="Margin" Value="4 0"/>
    </Style>

    <!-- Размер задан явно: у части иконок в файле записано разрешение, при котором WPF раздувает картинку -->
    <Style x:Key="ToolBarImageBaseStyle" TargetType="Image">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
    </Style>

    <Style x:Key="ToolBarCaptionBaseStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="4 0 2 0"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="QueryTextBaseStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="10 8 10 6"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ResultTextBaseStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="20 4 10 0"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <Style x:Key="TabControlBaseStyle" TargetType="TabControl">
        <Setter Property="Margin" Value="8 0 8 6"/>
    </Style>

    <Style x:Key="TabItemBaseStyle" TargetType="TabItem">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12 6"/>
    </Style>

    <Style x:Key="ResultGridBaseStyle" TargetType="DataGrid">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="SelectionMode" Value="Single"/>
    </Style>

    <Style x:Key="NumberCellBaseStyle" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0 0 6 0"/>
    </Style>

    <Style x:Key="StatusTextBaseStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="4 0 12 0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Результат запроса одним числом -->
    <Style x:Key="BigNumberBaseStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="24 16"/>
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Окна ввода и входа -->
    <Style x:Key="InputPromptBaseStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="2 8 0 4"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="InputListBaseStyle" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="360"/>
        <Setter Property="Padding" Value="6 4"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="InputBoxBaseStyle" TargetType="TextBox">
        <Setter Property="MinWidth" Value="360"/>
        <Setter Property="Padding" Value="6 4"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Короткий список: начало, срок и экземпляры подписки в одну строку -->
    <Style x:Key="InputShortListBaseStyle" TargetType="ComboBox" BasedOn="{StaticResource InputListBaseStyle}">
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="Margin" Value="0 0 16 0"/>
    </Style>

    <!-- Стоимость и итог заказа -->
    <Style x:Key="SumTextBaseStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="2 6"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Панель команд над таблицей вкладки -->
    <Style x:Key="CommandPanelBaseStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0 4 0 0"/>
    </Style>

    <Style x:Key="InputPasswordBaseStyle" TargetType="PasswordBox">
        <Setter Property="MinWidth" Value="360"/>
        <Setter Property="Padding" Value="6 4"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

</ResourceDictionary>
