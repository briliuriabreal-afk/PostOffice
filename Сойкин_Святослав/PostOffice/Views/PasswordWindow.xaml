<Window x:Class="PostOffice.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource WindowStyle}"
        Language="ru-RU"
        Icon="/Assets/Images/icon.png"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=PbxOld}"
        Title="Смена пароля">

    <StackPanel Margin="24 18">
        <TextBlock Text="Текущий пароль"
                   Style="{DynamicResource InputPromptStyle}"/>
        <PasswordBox x:Name="PbxOld"
                     Style="{DynamicResource InputPasswordStyle}"/>

        <TextBlock x:Name="TblNew"
                   Text="Новый пароль"
                   Style="{DynamicResource InputPromptStyle}"/>
        <PasswordBox x:Name="PbxNew"
                     Style="{DynamicResource InputPasswordStyle}"/>

        <TextBlock Text="Новый пароль ещё раз"
                   Style="{DynamicResource InputPromptStyle}"/>
        <PasswordBox x:Name="PbxRepeat"
                     Style="{DynamicResource InputPasswordStyle}"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0 16 0 0">
            <Button Content="Сменить"
                    Style="{DynamicResource DialogButtonStyle}"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
            <Button Content="Отмена"
                    Style="{DynamicResource DialogButtonStyle}"
                    IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
